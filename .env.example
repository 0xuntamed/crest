# Postgres connection string
DATABASE_URL=postgres://crest:crest@localhost:5433/crest

# Public base URL (used for badge embed snippets and OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Ed25519 private key (PKCS#8 PEM, \n-escaped). Generate with `npm run keygen`.
# If unset, a key is generated on first use and stored in the server_keys table.
# CREST_SIGNING_KEY=

# Optional: force the author cookie Secure flag (defaults to true in production). Set false only for plain-HTTP setups.
# COOKIE_SECURE=true
