{
  "name": "crest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node scripts/migrate.mjs",
    "keygen": "node scripts/keygen.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --no-warnings tests/e2e.ts",
    "ext:harness": "node tests/ext-harness/server.mjs",
    "test:e2e:ext": "node --experimental-strip-types --no-warnings tests/e2e-ext.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
